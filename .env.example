# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme

# AWS Bedrock
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_DEFAULT_REGION=eu-west-1

# GitHub
GITHUB_TOKEN=your_github_pat
TARGET_REPO=expressjs/express

# SonarQube (set after first run — see README)
SONARQUBE_TOKEN=

# Langfuse — keys must be set BEFORE the first `docker compose up`; the stack
# auto-provisions a project against them (see README Step 4). Example values below
# work out of the box; change them if you like (format: pk-lf-... / sk-lf-...).
LANGFUSE_PUBLIC_KEY=pk-lf-00000000-0000-0000-0000-000000000000
LANGFUSE_SECRET_KEY=sk-lf-00000000-0000-0000-0000-000000000000
LANGFUSE_SECRET=changeme_random_32chars
LANGFUSE_SALT=changeme_random_32chars
# Password for the auto-created Langfuse admin user (admin@techdebt.local)
LANGFUSE_INIT_USER_PASSWORD=changeme_local_pw123
